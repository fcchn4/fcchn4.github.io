{{/* Hugo's embedded sitemap template, plus an x-default alternate pointing at the default-language version. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ $defaultLang := hugo.Sites.Default.Language.Lang }}
  {{ range where .Pages "Sitemap.Disable" "ne" true }}
    {{- /* tags and series (lists and terms) are noindex, so they stay out of the sitemap. */ -}}
    {{- $skip := and (in (slice "taxonomy" "term") .Kind) (in (slice "tags" "series") .Data.Plural) -}}
    {{- if and .Permalink (not $skip) -}}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ if .IsTranslated }}{{ range .AllTranslations }}
    <xhtml:link
                rel="alternate"
                hreflang="{{ .Language.Locale }}"
                href="{{ .Permalink }}"
                />{{ if eq .Language.Lang $defaultLang }}
    <xhtml:link
                rel="alternate"
                hreflang="x-default"
                href="{{ .Permalink }}"
                />{{ end }}{{ end }}{{ end }}
  </url>
    {{- end -}}
  {{ end }}
</urlset>
